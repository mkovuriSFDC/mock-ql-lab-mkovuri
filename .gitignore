.sfdx/
.sf/
.localdevserver/
deploy-options.json

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# Environment
.env
.env.*
!.env.example

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Bootstrap state
.bootstrap-state

# Per-machine local Claude settings (never tracked).
.claude/settings.local.json

# Per-machine debounce stamps for the SessionStart nudges (install / drift).
.claude/.skills-freshness-check
.claude/.skills-drift-check
.claude/.resync-drift-check

# Per-machine setup state: Scopezilla source location + pending setup steps
# (decisions/0071). The engagement profile beside it (engagement.json) IS tracked.
.launchpad/local.json
# Build briefs are generated per build and never committed; the PR carries their
# stamp line instead (decisions/0082 W6).
.launchpad/briefs/

# Note: .agents/ and .claude/skills/* ARE tracked once a consultant
# intentionally adds them (e.g. via `npx skills add forcedotcom/sf-skills`).
# That way the engagement repo distributes the skill bodies the pod is
# actually using, not just skills-lock.json. Keep them out of .gitignore —
# unless .launchpad/repo.json sets commit_skills: false, in which case
# /ql-init-engagement appends an ignore block for them below (decisions/0072).

# ---- Salesforce DX (from sf project generate) ----
